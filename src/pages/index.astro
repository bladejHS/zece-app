---
/**
 * Index — Pagină de validare Faza 1
 * Demonstrează tokenurile CSS și componentele UI fundamentale
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import Card from '@/components/ui/Card.astro';
import TimerSegmented from '@/components/ui/TimerSegmented.astro';
import ProgressBar from '@/components/ui/ProgressBar.astro';
---

<BaseLayout title="ZECE — Industrial Tactical Premium">
  <main class="page">
    <header class="hero">
      <h1 class="hero-title">UMBRA</h1>
      <p class="hero-sub">Hybrid365 · Sistem holistic de pregătire</p>
    </header>

    <section class="grid">
      <Card>
        <h2>Timer Antrenament</h2>
        <div class="timer-row">
          <TimerSegmented seconds={180} phase="work" label="Runda 1 · Efort" />
          <TimerSegmented seconds={60} phase="rest" label="Pauză" />
          <TimerSegmented seconds={5} phase="cooldown" label="Final" />
        </div>
      </Card>

      <Card variant="elevated">
        <h2>Progres Sesiune</h2>
        <div class="progress-stack">
          <ProgressBar value={75} variant="work" label="Volum Total" showValue />
          <ProgressBar value={40} variant="rest" label="Recuperare" showValue />
          <ProgressBar value={92} variant="success" label="Completare" showValue />
        </div>
      </Card>

      <Card variant="outlined">
        <h2>Acțiuni</h2>
        <div class="btn-row">
          <Button variant="pri">Start Sesiune</Button>
          <Button variant="armed">Luptă</Button>
          <Button variant="ghost">Pauză</Button>
          <Button variant="danger">Stop</Button>
          <Button variant="glow">AI Coach</Button>
        </div>
      </Card>
    </section>

    <footer class="foot">
      <p>ZECE v9 · Astro SSG · Industrial Tactical Premium</p>
    </footer>
  </main>
</BaseLayout>

<style>
  .page {
    max-width: 720px;
    margin: 0 auto;
    padding: var(--s8x) var(--s4x);
    display: flex;
    flex-direction: column;
    gap: var(--s8x);
  }

  .hero {
    text-align: center;
    padding: var(--s10x) 0;
  }

  .hero-title {
    font-family: var(--fd);
    font-size: clamp(3rem, 14vw, 5rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--tx);
    line-height: 0.9;
  }

  .hero-sub {
    font-family: var(--fd);
    font-size: var(--t-lg);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--mu);
    margin-top: var(--s3x);
  }

  .grid {
    display: grid;
    gap: var(--s6x);
  }

  .grid h2 {
    font-size: var(--t-xl);
    margin-bottom: var(--s4x);
    color: var(--tx);
  }

  .timer-row {
    display: flex;
    justify-content: space-around;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s4x);
  }

  .progress-stack {
    display: flex;
    flex-direction: column;
    gap: var(--s4x);
  }

  .btn-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s3x);
    justify-content: center;
  }

  .foot {
    text-align: center;
    padding: var(--s6x) 0;
    color: var(--mu2);
    font-size: var(--t-xs);
    font-family: var(--fm);
    letter-spacing: 0.04em;
  }
</style>