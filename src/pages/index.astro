---
/* Pagina unică a aplicației: antetul, deschiderea și containerele în care desenează aplicația
   (src/legacy, unite de integrations/legacy-app.ts, plus modulele TypeScript din src/ui și src/lib). */
import '../styles/fonts.css';
import '../styles/legacy.css';
import '../styles/tokens.css';
import '../styles/tactical.css';
import '../styles/intro.css';
import Intro from '../components/Intro.astro';
import TopBar from '../components/TopBar.astro';
import { BRAND } from '../ui/brand';
---
<!DOCTYPE html>
<html lang="ro">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{BRAND.name} — {BRAND.sub}</title>
<meta name="description" content={BRAND.tagline}>
<meta name="theme-color" content="#050607">
<link rel="icon" type="image/svg+xml" href="icon.svg">
<link rel="apple-touch-icon" sizes="180x180" href="apple-touch-icon.png">
<link rel="manifest" href="manifest.webmanifest">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content={BRAND.name}>
<meta name="mobile-web-app-capable" content="yes">
<script is:inline>/* tema (întunecată / luminoasă) se aplică înainte de prima randare, ca să nu clipească */
try{ var m=JSON.parse(localStorage.getItem('zece3:mode')||'"dark"'); if(m==='auto') m=matchMedia('(prefers-color-scheme: light)').matches?'light':'dark'; if(m==='light') document.documentElement.setAttribute('data-mode','light'); if(JSON.parse(localStorage.getItem('zece3:bg')||'"anthr"')==='black') document.documentElement.classList.add('bg-black'); }catch(e){}</script>
</head>
<body class="fx-normal">
<canvas id="pt" aria-hidden="true"></canvas>
<div id="amb" aria-hidden="true"></div><div id="grain" aria-hidden="true"></div>

<Intro />

<aside class="side" id="side" aria-label="Meniu"></aside>
<TopBar>
  <button class="hr-live hrc off" id="hrTop" data-a="hrOpen" aria-label="Puls"><svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21.2l8.8-8.8a5.5 5.5 0 0 0 0-7.8z"/></svg><span class="v">—</span><span class="z"></span></button>
  <button class="ib" id="bell" data-a="notifOpen" aria-label="Notificări"></button>
  <button class="ib" id="gear" data-a="tab" data-k="set" aria-label="Setări"></button>
</TopBar>

<main class="view" id="view"></main>
<div id="pillRoot"></div>
<nav class="nav" id="nav" aria-label="Navigare"></nav>
<div id="fxRoot"></div>
<div id="tmRoot"></div>
<div id="ovRoot"></div>
<div id="calRoot"></div>
<div id="shRoot"></div>
<div id="rcRoot"></div>
<div id="palRoot"></div>
<div id="menuRoot"></div>
<div class="ch-tip" id="chTip" aria-hidden="true"></div>
<script>import '../scripts/main.ts';</script>
</body>
</html>
