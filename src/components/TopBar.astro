---
/* Antetul: semnul, numele, căutarea, pulsul live, notificări, setări. Butoanele sunt completate de aplicație (render). */
import { BRAND, logoSvg } from '../ui/brand';
---
<header class="top"><div class="top-in">
  <span class="logo wait" set:html={logoSvg({ ticks: false })} />
  <div class="brand-w"><div class="brand">{BRAND.name}<small>{BRAND.sub}</small></div></div>
  <button class="search-t" id="srchT" data-a="palOpen" aria-label="Caută sau scrie o comandă (Ctrl+K)"><svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg><span>Caută sau scrie o comandă</span><kbd>Ctrl K</kbd></button>
  <slot />
</div></header>
