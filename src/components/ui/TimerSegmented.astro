---
/**
 * TimerSegmented — Font mono tabular-nums, dimensiune responsivă
 * Faze colorate semantic: amber=efort, cyan=repaus, red=critic
 */
export interface Props {
  seconds?: number;
  phase?: 'work' | 'rest' | 'prep' | 'breath' | 'stretch' | 'cooldown';
  label?: string;
  class?: string;
}

const {
  seconds = 0,
  phase = 'work',
  label = '',
  class: className = '',
} = Astro.props;

const mins = Math.floor(seconds / 60);
const secs = seconds % 60;
const display = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
---

<div class:list={['timer', `timer-${phase}`, className]} role="timer" aria-live="polite" aria-label={label || `${mins} minute și ${secs} secunde`}>
  {label && <span class="timer-label">{label}</span>}
  <span class="timer-digits">{display}</span>
</div>

<style>
  .timer {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--s1x);
  }

  .timer-digits {
    font-family: var(--fm);
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    line-height: 1;
    /* responsive: clamp(3rem, 12vw, 6rem) */
    font-size: clamp(3rem, 12vw, 6rem);
    letter-spacing: -0.02em;
    color: var(--tx);
    transition: color var(--dur-interact) var(--e-snap);
  }

  .timer-label {
    font-family: var(--fd);
    font-size: var(--t-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--mu);
  }

  /* === PHASE COLORS === */
  .timer-work .timer-digits { color: var(--amber); }
  .timer-rest .timer-digits { color: var(--cyan); }
  .timer-prep .timer-digits { color: var(--mu); }
  .timer-breath .timer-digits { color: var(--cyan); }
  .timer-stretch .timer-digits { color: var(--ok); }
  .timer-cooldown .timer-digits { color: var(--cyan); }

  /* puls vizual la ultimele 3 secunde (adăugat prin JS) */
  .timer.critical .timer-digits {
    color: var(--red);
    animation: pulse-critical 0.6s var(--e-snap) infinite alternate;
  }

  @keyframes pulse-critical {
    from { opacity: 1; transform: scale(1); }
    to { opacity: 0.7; transform: scale(1.04); }
  }
</style>