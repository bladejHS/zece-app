---
/**
 * Card — Glass panel cu spotlight hover effect
 * backdrop-blur(12px) + border 8% opacity + carbon/metallic accents
 */
export interface Props {
  variant?: 'default' | 'elevated' | 'outlined';
  class?: string;
  id?: string;
}

const {
  variant = 'default',
  class: className = '',
  id,
} = Astro.props;
---

<div
  id={id}
  class:list={['card', `card-${variant}`, className]}
  onmousemove="this.style.setProperty('--mx',event.offsetX+'px');this.style.setProperty('--my',event.offsetY+'px')"
  onmouseleave="this.style.removeProperty('--mx');this.style.removeProperty('--my')"
>
  <slot />
</div>

<style>
  .card {
    position: relative;
    background: var(--glass);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--ln);
    border-radius: var(--r-md);
    padding: var(--s6x);
    box-shadow: var(--sh-card);
    overflow: hidden;
    transition: border-color var(--dur-transition) var(--e-snap);
  }

  /* spotlight hover effect */
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      600px circle at var(--mx, -999px) var(--my, -999px),
      rgba(255,255,255,0.04),
      transparent 40%
    );
    opacity: 0;
    transition: opacity var(--dur-transition) var(--e-snap);
    pointer-events: none;
  }
  .card:hover::before {
    opacity: 1;
  }

  /* === ELEVATED === */
  .card-elevated {
    background: var(--glass2);
    box-shadow: var(--sh-pop);
    border-color: var(--ln2);
  }

  /* === OUTLINED === */
  .card-outlined {
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-color: var(--ln2);
  }

  /* metallic top edge */
  .card::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--metal-border);
    pointer-events: none;
  }
</style>