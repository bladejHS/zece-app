---
/**
 * Button — Industrial Tactical Premium
 * Min 64px touch target, gradient metalic border, active state cu translateY + inner shadow
 * Variante: pri | ghost | danger | armed | glow
 */
export interface Props {
  variant?: 'pri' | 'ghost' | 'danger' | 'armed' | 'glow';
  size?: 'sm' | 'md' | 'lg';
  disabled?: boolean;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
}

const {
  variant = 'pri',
  size = 'md',
  disabled = false,
  type = 'button',
  class: className = '',
} = Astro.props;
---

<button
  type={type}
  disabled={disabled}
  class:list={['btn', `btn-${variant}`, `btn-${size}`, className]}
>
  <slot />
</button>

<style>
  .btn {
    /* reset */
    appearance: none;
    border: none;
    background: none;
    cursor: pointer;
    font-family: var(--fd);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--tx);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--s2x);
    position: relative;
    overflow: hidden;
    transition:
      transform var(--dur-interact) var(--e-snap),
      box-shadow var(--dur-interact) var(--e-snap),
      background var(--dur-interact) var(--e-snap);

    /* touch target minim 64px */
    min-height: 64px;
    min-width: 64px;
    padding: var(--s3x) var(--s6x);
    border-radius: var(--r-xs);

    /* metallic border gradient */
    background-clip: padding-box;
  }

  /* === SIZE VARIANTS === */
  .btn-sm {
    min-height: 48px;
    padding: var(--s2x) var(--s4x);
    font-size: var(--t-sm);
  }
  .btn-md {
    font-size: var(--t-md);
  }
  .btn-lg {
    min-height: 72px;
    padding: var(--s4x) var(--s8x);
    font-size: var(--t-lg);
  }

  /* === PRIMARY === */
  .btn-pri {
    background: var(--ac);
    color: var(--bg);
    box-shadow: var(--sh-btn);
  }
  .btn-pri:hover:not(:disabled) {
    filter: brightness(1.08);
  }
  .btn-pri:active:not(:disabled) {
    transform: translateY(1px);
    box-shadow: var(--sh-active);
  }

  /* === GHOST === */
  .btn-ghost {
    background: var(--a08);
    color: var(--tx);
    border: 1px solid var(--ln2);
  }
  .btn-ghost:hover:not(:disabled) {
    background: var(--a14);
    border-color: var(--ln3);
  }
  .btn-ghost:active:not(:disabled) {
    transform: translateY(1px);
    box-shadow: var(--sh-active);
  }

  /* === DANGER === */
  .btn-danger {
    background: var(--red);
    color: #fff;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.15), 0 8px 24px -12px rgba(201,90,74,0.4);
  }
  .btn-danger:hover:not(:disabled) {
    filter: brightness(1.1);
  }
  .btn-danger:active:not(:disabled) {
    transform: translateY(1px);
    box-shadow: inset 0 2px 4px rgba(0,0,0,0.4);
  }

  /* === ARMED (amber accent for active/combat states) === */
  .btn-armed {
    background: var(--amber);
    color: #0A0A0C;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.2), 0 8px 24px -12px rgba(232,168,76,0.4);
  }
  .btn-armed:hover:not(:disabled) {
    filter: brightness(1.08);
  }
  .btn-armed:active:not(:disabled) {
    transform: translateY(1px);
    box-shadow: var(--sh-active);
  }

  /* === GLOW (shine animation for CTAs) === */
  .btn-glow {
    background: var(--ac);
    color: var(--bg);
    box-shadow: var(--sh-btn);
  }
  .btn-glow::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      transparent 40%,
      rgba(255,255,255,0.25) 45%,
      rgba(255,255,255,0.35) 50%,
      rgba(255,255,255,0.25) 55%,
      transparent 60%
    );
    transform: translateX(-100%);
    animation: shine 2.5s ease-in-out infinite;
  }
  @keyframes shine {
    0%, 100% { transform: translateX(-100%); }
    50% { transform: translateX(100%); }
  }

  /* === DISABLED === */
  .btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
    pointer-events: none;
  }

  /* === FOCUS VISIBLE === */
  .btn:focus-visible {
    outline: 2px solid var(--amber);
    outline-offset: 2px;
  }
</style>