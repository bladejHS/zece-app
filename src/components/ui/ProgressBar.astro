---
/**
 * ProgressBar — Animated fill cu culori semantice per stare
 */
export interface Props {
  value: number;   /* 0–100 */
  max?: number;
  variant?: 'default' | 'work' | 'rest' | 'success' | 'danger';
  label?: string;
  showValue?: boolean;
  class?: string;
}

const {
  value,
  max = 100,
  variant = 'default',
  label = '',
  showValue = false,
  class: className = '',
} = Astro.props;

const pct = Math.min(100, Math.max(0, (value / max) * 100));
---

<div
  class:list={['progress', `progress-${variant}`, className]}
  role="progressbar"
  aria-valuenow={value}
  aria-valuemin={0}
  aria-valuemax={max}
  aria-label={label}
>
  {label && <span class="progress-label">{label}</span>}
  <div class="progress-track">
    <div class="progress-fill" style={`--pct:${pct / 100}`} />
  </div>
  {showValue && <span class="progress-value">{Math.round(pct)}%</span>}
</div>

<style>
  .progress {
    display: flex;
    flex-direction: column;
    gap: var(--s1x);
    width: 100%;
  }

  .progress-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .progress-label {
    font-family: var(--fd);
    font-size: var(--t-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--mu);
  }

  .progress-value {
    font-family: var(--fm);
    font-size: var(--t-xs);
    font-variant-numeric: tabular-nums;
    color: var(--mu);
  }

  .progress-track {
    height: 6px;
    background: var(--ln);
    border-radius: var(--r-full);
    overflow: hidden;
    position: relative;
  }

  .progress-fill {
    position: absolute;
    inset: 0;
    border-radius: var(--r-full);
    background: var(--ac);
    transform-origin: left center;
    transform: scaleX(var(--pct, 0));
    transition: transform var(--dur-transition) var(--e-snap);
    will-change: transform;
  }

  /* === VARIANT COLORS === */
  .progress-work .progress-fill { background: var(--amber); }
  .progress-rest .progress-fill { background: var(--cyan); }
  .progress-success .progress-fill { background: var(--ok); }
  .progress-danger .progress-fill { background: var(--red); }
</style>