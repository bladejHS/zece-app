---
/* Deschiderea aplicației: stilurile în src/styles/intro.css, pornirea și ieșirea în src/legacy/48-16-pornire.js (introStart/introExit).
   Pe negru, trei rândunici intră în zbor din stânga-jos, pe arce ușor diferite, și se așază în formația semnului FALCO;
   după aceea bat din aripi și planează. Apoi apare numele. La ieșire formația zboară în antet, unde e chiar logo-ul. */
import { BRAND, FLOCK, SWALLOW_BODY, SWALLOW_WINGS } from '../ui/brand';
const letters = [...BRAND.name];
/* de unde intră fiecare rândunică (față de locul ei din formație) */
const from: ReadonlyArray<readonly [string, string]> = [['-78vw', '46vh'], ['-64vw', '58vh'], ['-90vw', '30vh']];
---
<div class="intro" id="intro" aria-hidden="true">
  <div class="in-bg"></div>
  <div class="in-c">
    <div class="in-logo" id="inLogo">
      {FLOCK.map(([x, y, r, s], i) => { const [fx, fy] = from[i] ?? ['-80vw', '40vh']; return (
        <svg class="in-b" viewBox="0 0 100 100" style={`--i:${i};--ox:${x}%;--oy:${y}%;--fx:${fx};--fy:${fy}`}>
          <g transform={`translate(${x} ${y}) rotate(${r}) scale(${s})`}>
            <g class="in-bob" style={`--i:${i}`}>
              <path d={SWALLOW_BODY} />
              <path class="in-w" d={SWALLOW_WINGS} style={`--i:${i}`} />
            </g>
          </g>
        </svg>
      ); })}
    </div>
    <div class="in-word" aria-label={BRAND.name}>{letters.map((ch, i) => <span style={`--i:${i}`}>{ch}</span>)}</div>
    <div class="in-sub" id="inSub">{BRAND.motto}</div>
  </div>
  <div class="in-skip">atinge pentru a intra</div>
</div>
