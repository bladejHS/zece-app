---
/* Deschiderea aplicației: stilurile în src/styles/intro.css, pornirea și ieșirea în src/legacy/48-16-pornire.js (introStart/introExit).
   v17: „ținta se fixează" — reticulul se trasează, colțurile se strâng pe semn, blocare în amber (cu vibrație), lumina trece peste semn,
   apoi cuvântul ZECE; la ieșire semnul zboară în antet, iar fundalul se închide ca un diafragm spre el. Animația nu depinde de forma semnului. */
import { BRAND, logoSvg } from '../ui/brand';
const letters = [...BRAND.name];
/* gradațiile reticulului: la fiecare 5°, mai lungi la 30° */
const ticks = Array.from({ length: 72 }, (_, i) => i * 5);
---
<div class="intro" id="intro" aria-hidden="true">
  <div class="in-bg"><div class="in-topo"></div><div class="in-vig"></div></div>
  <div class="in-hud t"><span>ZECE // {BRAND.sub}</span><span class="in-live"><i></i>Sistem activ</span></div>
  <div class="in-c">
    <div class="in-tgt">
      <svg class="in-ret" viewBox="0 0 200 200" aria-hidden="true">
        <g class="in-ticks">{ticks.map((a) => <line x1="100" y1={a % 30 === 0 ? 3 : 6} x2="100" y2="11" transform={`rotate(${a} 100 100)`} />)}</g>
        <circle class="in-ring" cx="100" cy="100" r="92" pathLength="100" />
        <circle class="in-ring2" cx="100" cy="100" r="80" />
        <circle class="in-pulse" cx="100" cy="100" r="92" />
        <g class="in-cross"><path d="M100 0V18M100 182V200M0 100H18M182 100H200" /></g>
      </svg>
      <div class="in-brk" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
      <div class="in-logo" id="inLogo" set:html={logoSvg({ cls: 'in-mark' })} />
    </div>
    <div class="in-word">{letters.map((ch, i) => <span style={`--i:${i}`}>{ch}</span>)}</div>
    <div class="in-sub" id="inSub">{BRAND.sub}</div>
  </div>
  <div class="in-hud b"><div class="in-prog"><i></i></div><div class="in-st"><span class="a">Inițializare</span><span class="z">Pregătit</span></div></div>
  <div class="in-skip">atinge pentru a intra</div>
</div>
